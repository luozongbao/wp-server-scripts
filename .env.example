# Copy to .env and fill in. .env is git-ignored; keep it chmod 600.
# Parsed by lib/deploy_config.sh (never sourced). Format: KEY=VALUE, optional quotes, # comments.

# ---- Required -----------------------------------------------------------------
# Public URL of production and staging (include the scheme).
PROD_URL="https://example.com"
STG_URL="https://stg.example.com"

# Host directory that contains both file trees.
BASE_DIR="/home/example/project"
# Host path of the production files (rsync writes here).
PROD_PATH="/home/example/project/www"
# Host path of the staging files (rsync reads from here).
STG_PATH="/home/example/project/stg"
# Where dumps and file tarballs are written (rollback path).
BACKUP_DIR="/home/example/backups"

# MariaDB/MySQL container name (must have MYSQL_ROOT_PASSWORD).
DB_CONTAINER="example_db"
# WordPress/PHP container name (must contain wp-cli).
APP_CONTAINER="example_app"
# Docroot inside APP_CONTAINER for production and staging.
PROD_WP_PATH="/var/www/vhosts/example/html"
STG_WP_PATH="/var/www/vhosts/stg/html"

# ---- Optional -----------------------------------------------------------------
# Target table prefix for production. Unset = keep production's current prefix.
# When set, deploy renames the imported tables and rewrites prod wp-config.php to match.
# PROD_TABLE_PREFIX="wp_"

# Target table prefix for staging. Unset = adopt production's prefix.
# When set, sync renames the imported tables and rewrites staging wp-config.php to match.
# STG_TABLE_PREFIX="stg_"

# Full <script>...</script> tag written to production's theme mod on deploy.
# Unset = the header step is skipped.
# HEADER_SCRIPT="<script defer src='https://analytics.example.com/script.js' data-website-id='YOUR-ID'></script>"

# Theme mod the header script lives in.
# HEADER_THEME_MOD="header_scripts"

# Comma-separated slugs deactivated on staging by sync-prod-to-stg.sh. Unset = none.
# SECURITY_PLUGINS="wordfence,sucuri-scanner,all-in-one-wp-security-and-firewall"

# Slug activated on production by deploy-stg-to-prod.sh. Unset = skipped.
# PROD_SECURITY_PLUGIN="all-in-one-wp-security-and-firewall"

# user:group applied by chown after the production file sync (OpenLiteSpeed default).
# PROD_WP_OWNER="nobody:nogroup"
